{
  "datasets": [
    {
      "name": "latest_day",
      "displayName": "Latest collected day",
      "queryLines": [
        "SELECT service_date, bus_on_time_pct, ghost_trip_pct, cancelled_trips, observed_arrivals, bunched_pct, rail_avg_delay_seconds\n",
        "FROM daily_kpis\n",
        "WHERE service_date = (SELECT MAX(service_date) FROM daily_kpis)\n"
      ]
    },
    {
      "name": "daily",
      "displayName": "Daily KPIs",
      "queryLines": [
        "SELECT service_date, day_name, bus_on_time_pct, ghost_trip_pct, bunched_pct, bus_avg_delay_seconds, rail_avg_delay_seconds\n",
        "FROM daily_kpis\n"
      ]
    },
    {
      "name": "ghost_by_reason",
      "displayName": "Ghost trips by reason",
      "queryLines": [
        "SELECT service_date, CASE reason WHEN 'cancelled' THEN 'Cancelled by MARTA' ELSE 'No realtime trace' END AS reason, COUNT(*) AS trips\n",
        "FROM ghost_trips\n",
        "GROUP BY service_date, reason\n"
      ]
    },
    {
      "name": "otp_by_hour",
      "displayName": "On-time by hour",
      "queryLines": [
        "SELECT hour_local, ROUND(100 * SUM(on_time) / NULLIF(SUM(on_time + early + late), 0), 1) AS on_time_pct, SUM(arrivals) AS arrivals\n",
        "FROM otp_route_hour\n",
        "WHERE service_date >= DATE_SUB((SELECT MAX(service_date) FROM otp_route_hour), 6)\n",
        "GROUP BY hour_local\n"
      ]
    },
    {
      "name": "worst_routes",
      "displayName": "Least punctual routes (last 7 days)",
      "queryLines": [
        "SELECT CONCAT('Route ', route_short_name) AS route, ROUND(100 * SUM(on_time) / NULLIF(SUM(on_time + early + late), 0), 1) AS on_time_pct, SUM(arrivals) AS arrivals\n",
        "FROM otp_route_hour\n",
        "WHERE service_date >= DATE_SUB((SELECT MAX(service_date) FROM otp_route_hour), 6)\n",
        "GROUP BY route_short_name\n",
        "HAVING SUM(arrivals) >= 500\n",
        "ORDER BY on_time_pct\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "worst_stops",
      "displayName": "Stops with the longest delays (last 7 days)",
      "queryLines": [
        "SELECT stop_name, ROUND(SUM(avg_delay_seconds * arrivals) / SUM(arrivals) / 60, 1) AS avg_delay_minutes, SUM(arrivals) AS arrivals\n",
        "FROM stop_delay\n",
        "WHERE service_date >= DATE_SUB((SELECT MAX(service_date) FROM stop_delay), 6)\n",
        "GROUP BY stop_name\n",
        "HAVING SUM(arrivals) >= 100\n",
        "ORDER BY avg_delay_minutes DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "rail_lines",
      "displayName": "Rail delay by line (last 7 days)",
      "queryLines": [
        "SELECT line, ROUND(SUM(avg_delay_seconds * realtime_predictions) / NULLIF(SUM(realtime_predictions), 0)) AS avg_delay_seconds\n",
        "FROM rail_line_health\n",
        "WHERE service_date >= DATE_SUB((SELECT MAX(service_date) FROM rail_line_health), 6)\n",
        "GROUP BY line\n"
      ]
    }
  ],
